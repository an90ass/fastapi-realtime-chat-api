# Database (Async PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/realtime_chat_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & JWT
SECRET_KEY=change_this_to_a_very_secure_secret_key_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
PROJECT_NAME=Real-time Chat API
DEBUG=False
CORS_ORIGINS=["*"]